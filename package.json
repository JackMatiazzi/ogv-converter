{
  "name": "ogv-converter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "node scripts/copy-ffmpeg.js",
    "build": "npm run typecheck && vite build",
    "ci": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
